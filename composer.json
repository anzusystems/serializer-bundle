{
    "name": "anzusystems/serializer-bundle",
    "description": "Serializer bundle.",
    "type": "symfony-bundle",
    "keywords": ["symfony", "anzusystems"],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "AnzuSystems Community",
            "homepage": "https://github.com/orgs/anzusystems/people"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "nelmio/api-doc-bundle": "^5.9",
        "symfony/type-info": "^7.0|^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.18",
        "doctrine/orm": "^3.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "slevomat/coding-standard": "8.22",
        "symfony/dotenv": "^7.0|^8.0",
        "symfony/test-pack": "^1.1",
        "symfony/uid": "^7.0|^8.0",
        "symfony/var-exporter": "^7.0|^8.0",
        "symplify/easy-coding-standard": "^13.0"
    },
    "suggest": {
        "doctrine/orm": "Enable EntityIdHandler."
    },
    "autoload": {
        "psr-4": {
            "AnzuSystems\\SerializerBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AnzuSystems\\SerializerBundle\\Tests\\": "tests",
            "AnzuSystems\\SerializerBundle\\Tests\\TestApp\\": "tests/TestApp"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "phpstan/extension-installer": true
        }
    }
}
